<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Captures a product or service requested for a Case and supports a future approval-to-quote lifecycle.</description>
    <enableActivities>false</enableActivities>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <externalSharingModel>Private</externalSharingModel>
    <label>Custom Product Request</label>
    <nameField>
        <displayFormat>CPR-{00000}</displayFormat>
        <label>Request Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Custom Product Requests</pluralLabel>
    <sharingModel>ReadWrite</sharingModel>
</CustomObject>
