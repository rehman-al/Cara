<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prices_Must_Be_Nonnegative</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Estimated_Cost__c &lt; 0, Selling_Price__c &lt; 0)</errorConditionFormula>
    <errorMessage>Estimated Cost and Selling Price cannot be negative.</errorMessage>
</ValidationRule>
