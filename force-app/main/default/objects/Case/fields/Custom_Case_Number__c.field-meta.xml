<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Custom_Case_Number__c</fullName>
    <description>Case number prefixed according to the Case record type.</description>
    <externalId>false</externalId>
    <formula>CASE(
    RecordType.DeveloperName,
    &quot;General_Enquiry&quot;, &quot;GE_&quot;,
    &quot;Compliance&quot;, &quot;COMP_&quot;,
    &quot;Sales_Follow_up&quot;, &quot;SALES_&quot;,
    &quot;KYC_Required&quot;, &quot;KYC_&quot;,
    &quot;&quot;
) &amp; CaseNumber</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Custom Case Number</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
