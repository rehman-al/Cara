<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Case_EntitlementId</name>
        <label>Set Case EntitlementId</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.EntitlementId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varEntitlementId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Case_Entitlement</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_SLA_Process_Compliance</name>
        <label>Set SLA Process - Compliance</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varSlaProcessId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>552FV004Zg5ibgeYIA</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Existing_Entitlement</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_SLA_Process_General_Enquiry</name>
        <label>Set SLA Process - General Enquiry</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varSlaProcessId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>552FV004Zg5mnpgYIA</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Existing_Entitlement</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_SLA_Process_Sales_Follow_Up</name>
        <label>Set SLA Process - Sales Follow-Up</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varSlaProcessId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>552FV004Zg5qzyiYIA</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Existing_Entitlement</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Use_Existing_Entitlement</name>
        <label>Use Existing Entitlement</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varEntitlementId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Existing_Entitlement.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Set_Case_EntitlementId</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Use_New_Entitlement</name>
        <label>Use New Entitlement</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varEntitlementId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_Entitlement.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Set_Case_EntitlementId</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Determine_SLA_Process</name>
        <label>Determine SLA Process</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Matching SLA Track</defaultConnectorLabel>
        <rules>
            <name>Is_Compliance</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Compliance</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_SLA_Process_Compliance</targetReference>
            </connector>
            <label>Is Compliance</label>
        </rules>
        <rules>
            <name>Is_Sales_Follow_Up</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales_Follow_up</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_SLA_Process_Sales_Follow_Up</targetReference>
            </connector>
            <label>Is Sales Follow-Up</label>
        </rules>
        <rules>
            <name>Is_General_Enquiry</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>General_Enquiry</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_SLA_Process_General_Enquiry</targetReference>
            </connector>
            <label>Is General Enquiry</label>
        </rules>
    </decisions>
    <decisions>
        <name>Entitlement_Exists</name>
        <label>Entitlement Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Entitlement</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Entitlement Yet</defaultConnectorLabel>
        <rules>
            <name>Found_Entitlement</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Entitlement.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Use_Existing_Entitlement</targetReference>
            </connector>
            <label>Found Entitlement</label>
        </rules>
    </decisions>
    <description>SOW Point SC-6 - Case lifecycle and SLAs. Auto-assigns the right Entitlement (and so the right SLA/Milestone process) to every open Case based on its Record Type, creating an open-ended Entitlement for the Case&apos;s Account the first time one is needed. Without this, the SC-6 Entitlement Processes (kyc required sla, general enquiry sla v2, sales follow-up sla v2, compliance sla v2) would only ever apply to accounts someone manually set up an Entitlement for.</description>
    <environments>Default</environments>
    <formulas>
        <name>New_Entitlement_End_Date</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 1095</expression>
    </formulas>
    <formulas>
        <name>New_Entitlement_Name</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.Account.Name} &amp; &quot; - Case SLA&quot;, 80)</expression>
    </formulas>
    <interviewLabel>Case Assign Entitlement {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case Assign Entitlement</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Entitlement</name>
        <label>Create Entitlement</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Use_New_Entitlement</targetReference>
        </connector>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>EndDate</field>
            <value>
                <elementReference>New_Entitlement_End_Date</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>New_Entitlement_Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SlaProcessId</field>
            <value>
                <elementReference>varSlaProcessId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StartDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type</field>
            <value>
                <stringValue>Phone Support</stringValue>
            </value>
        </inputAssignments>
        <object>Entitlement</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Existing_Entitlement</name>
        <label>Get Existing Entitlement</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Entitlement_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>SlaProcessId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varSlaProcessId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Entitlement</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Case_Entitlement</name>
        <label>Update Case Entitlement</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Determine_SLA_Process</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>EntitlementId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varEntitlementId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varSlaProcessId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
