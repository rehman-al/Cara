/*
 * Inbound SFCC balance (second/remaining) payment confirmation API. Called
 * once the customer completes payment on the balance link generated by
 * CARABalanceLinkQueueable. All business logic lives in
 * CARABalancePaymentService; this class only handles the HTTP
 * envelope, matching the shape of the existing CARAOrderStatusRestService.
 */
@RestResource(urlMapping='/cara/orders/balancePaymentConfirmation')
global with sharing class CARABalancePaymentRestService {

    @HttpPost
    global static void confirmBalancePayment() {
        try {
            CARABalancePaymentService.ConfirmationRequest payload = deserializePayload();
            CARABalancePaymentService.ConfirmationResult outcome =
                CARABalancePaymentService.confirmBalancePayment(payload);

            writeResponse(outcome.success ? 200 : statusCodeFor(outcome.code), outcome);
        } catch (IntegrationException exceptionRecord) {
            writeResponse(400, failureOutcome('MISSING_REQUIRED_FIELD', exceptionRecord.getMessage()));
        } catch (Exception exceptionRecord) {
            writeResponse(500, failureOutcome('INTERNAL_ERROR', 'Unable to process the balance payment confirmation.'));
        }
    }

    private static CARABalancePaymentService.ConfirmationRequest deserializePayload() {
        if (RestContext.request == null || RestContext.request.requestBody == null) {
            throw new IntegrationException('A JSON request body is required.');
        }

        String requestBody = RestContext.request.requestBody.toString();
        if (String.isBlank(requestBody)) {
            throw new IntegrationException('A JSON request body is required.');
        }

        CARABalancePaymentService.ConfirmationRequest payload;
        try {
            payload = (CARABalancePaymentService.ConfirmationRequest) JSON.deserialize(
                requestBody,
                CARABalancePaymentService.ConfirmationRequest.class
            );
        } catch (Exception jsonException) {
            throw new IntegrationException('Invalid JSON payload: ' + jsonException.getMessage());
        }

        if (payload == null) {
            throw new IntegrationException('A valid payment confirmation payload is required.');
        }
        return payload;
    }

    private static Integer statusCodeFor(String code) {
        if (code == 'ORDER_NOT_FOUND') {
            return 404;
        }
        if (code == 'AMBIGUOUS_ORDER_REFERENCE' || code == 'AMOUNT_MISMATCH') {
            return 409;
        }
        if (code == 'ORDER_UPDATE_FAILED') {
            return 500;
        }
        return 400;
    }

    private static CARABalancePaymentService.ConfirmationResult failureOutcome(String code, String message) {
        CARABalancePaymentService.ConfirmationResult outcome =
            new CARABalancePaymentService.ConfirmationResult();
        outcome.success = false;
        outcome.code = code;
        outcome.message = message;
        return outcome;
    }

    private static void writeResponse(Integer statusCode, CARABalancePaymentService.ConfirmationResult outcome) {
        if (RestContext.response == null) {
            RestContext.response = new RestResponse();
        }
        RestContext.response.statusCode = statusCode;
        RestContext.response.addHeader('Content-Type', 'application/json');
        RestContext.response.responseBody = Blob.valueOf(JSON.serialize(outcome));
    }

    private class IntegrationException extends Exception {
    }
}