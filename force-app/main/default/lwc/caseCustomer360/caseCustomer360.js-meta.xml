<?xml version="1.0" encoding="UTF-8"?>

<LightningComponentBundle
    xmlns="http://soap.sforce.com/2006/04/metadata">

    <apiVersion>67.0</apiVersion>

    <isExposed>true</isExposed>

    <masterLabel>
        Case Customer 360
    </masterLabel>

    <description>
        Displays customer account, contact,
        order history, previous cases and
        conversations on a Case.
    </description>

    <targets>
        <target>
            lightning__RecordPage
        </target>
    </targets>

    <targetConfigs>

        <targetConfig
            targets="lightning__RecordPage">

            <objects>
                <object>Case</object>
            </objects>

        </targetConfig>

    </targetConfigs>

</LightningComponentBundle>